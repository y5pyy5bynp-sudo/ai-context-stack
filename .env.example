# This pack does not use a root .env.
# `make init-env` writes gitignored secrets here:
#
#   stacks/ragflow/.env   (from stacks/ragflow/.env.example)
#   stacks/khoj/.env      (from stacks/khoj/.env.example)
#
# Pins (enforced by preflight / init-env):
#   RAGFLOW_IMAGE=infiniflow/ragflow:v0.27.1
#   SVR_WEB_HTTP_PORT=8081
#   KHOJ_HTTP_PORT=42110
#   MEM_LIMIT=4294967296 on ~16 GiB hosts
#
# Never commit stacks/*/.env
