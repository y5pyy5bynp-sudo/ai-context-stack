# This is an EXAMPLE file. Real secrets belong in stacks/khoj/.env
# (created by `make init-env`, gitignored). Do not commit .env.
#
# Official Khoj compose, computer service removed, isolated from RAGFlow.

# Isolated compose project — do not share with RAGFlow.
COMPOSE_PROJECT_NAME=khoj

KHOJ_IMAGE=ghcr.io/khoj-ai/khoj:latest
KHOJ_HTTP_PORT=42110

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=database
POSTGRES_PORT=5432

KHOJ_DJANGO_SECRET_KEY=CHANGE_ME
KHOJ_DEBUG=False
KHOJ_ADMIN_EMAIL=admin@localhost
KHOJ_ADMIN_PASSWORD=CHANGE_ME

# Optional model providers (leave empty unless you use them).
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
KHOJ_DEFAULT_CHAT_MODEL=

KHOJ_TERRARIUM_URL=http://sandbox:8080
KHOJ_SEARXNG_URL=http://search:8080
KHOJ_TELEMETRY_DISABLE=True
